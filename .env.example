# Copy to .env and fill in your values. Never commit .env.
# Database Configuration
DATABASE_URL=postgresql://marketuser:change-me@localhost:5433/marketdata

# Market Data Providers (optional: Stooq works with no key)
ALPHA_VANTAGE_API_KEY=

# Kafka Configuration (optional: the API degrades gracefully without a broker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
